{
  "name": "clavis",
  "version": "0.0.2-alpha",
  "description": "Cross-platform encrypted notes application for storing banking info, PINs, passwords, and safe codes.",
  "main": "dist/main/index.js",
  "author": "Marcelo Salvador",
  "license": "MIT",
  "keywords": [
    "encryption",
    "passwords",
    "notes",
    "electron",
    "security"
  ],
  "type": "commonjs",
    "build": {
      "appId": "com.github.marcelosalvador.Clavis",
      "productName": "Clavis",
      "directories": {
        "output": "release"
      },
      "files": [
        "dist/**/*",
        "package.json"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://example.com/clavis/updates"
        }
      ],
      "win": {
        "target": [
          "nsis",
          "portable"
        ],
        "icon": "icons/windows/clavis.ico"
      },
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "artifactName": "Clavis Setup ${version}.${ext}"
      },
      "portable": {
        "artifactName": "Clavis Portable ${version}.${ext}"
      },
      "linux": {
        "target": [
          "AppImage"
        ],
        "icon": "icons/linux",
        "category": "Utility",
        "artifactName": "Clavis-${version}.${ext}"
      }
    },
  "scripts": {
    "clean": "rm -rf dist/ out/ release/",
    "build:main": "tsc",
    "copy:preload": "cp src/main/preload/index.js dist/main/preload.js",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run copy:preload && npm run build:renderer",
    "dev": "vite --config vite.config.ts",
    "start": "electron .",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "flatpak-make": "flatpak-builder --repo=repo build-dir flatpak/com.github.marcelosalvador.Clavis.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^44.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "uuid": "^11.1.0"
  }
}
